<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>HangAll</AssemblyName>
    <RootNamespace>HangAll</RootNamespace>
    <StartupObject>HangAll.Program</StartupObject>
    <ApplicationIcon>Assets\HangAll.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <Product>HangAll</Product>
    <Company>WatsonLearnCode</Company>
    <Authors>HangAll</Authors>
    <Description>Everything, hung within reach. A line at the top of your screen for screenshots, files and notes.</Description>
    <Copyright>Copyright (c) 2026 HangAll contributors</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/WatsonLearnCode/HangAll</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/WatsonLearnCode/HangAll</PackageProjectUrl>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;WFAC010</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TestBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);HANGALL_TEST</DefineConstants>
    <AssemblyName>HangAllTest</AssemblyName>
    <Product>HangAll 测试版</Product>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\HangAll.ico" />
    <Resource Include="Assets\Mark.png" />
    <Resource Include="Assets\Lockup.png" />
    <Resource Include="Assets\LockupDark.png" />
    <Resource Include="Assets\AuthorWatson.jpg" />
    <Resource Include="Assets\Fonts\Manrope-ExtraBold.ttf" />
    <Resource Include="Assets\clear-run.gif" />
  </ItemGroup>

</Project>
