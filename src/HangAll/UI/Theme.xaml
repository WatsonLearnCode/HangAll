<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:HangAll.UI">

    <!-- Defaults; Theme.Apply() replaces them for dark mode. -->
    <SolidColorBrush x:Key="MenuBg" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="MenuBorder" Color="#1A000000"/>
    <SolidColorBrush x:Key="MenuFg" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="MenuFgSecondary" Color="#737373"/>
    <SolidColorBrush x:Key="MenuHover" Color="#0D000000"/>
    <SolidColorBrush x:Key="MenuIconBg" Color="#0A000000"/>
    <SolidColorBrush x:Key="MenuChecked" Color="#141E6FFF"/>
    <SolidColorBrush x:Key="MenuFocus" Color="#1E6FFF"/>
    <SolidColorBrush x:Key="MenuSeparator" Color="#14000000"/>
    <SolidColorBrush x:Key="SettingsWorkspaceBg" Color="#ADFFFFFF"/>
    <SolidColorBrush x:Key="SettingsWorkspaceBorder" Color="#14000000"/>
    <SolidColorBrush x:Key="SettingsHitSurface" Color="#01000000"/>
    <SolidColorBrush x:Key="SettingsTextPrimary" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="SettingsTextSecondary" Color="#5F6368"/>
    <SolidColorBrush x:Key="SettingsTextTertiary" Color="#6A6F76"/>
    <SolidColorBrush x:Key="SettingsBrandTileBg" Color="#E8FFFFFF"/>
    <SolidColorBrush x:Key="SettingsBrandTileBorder" Color="#1A000000"/>
    <SolidColorBrush x:Key="SettingsAvatarBorder" Color="#2E000000"/>
    <SolidColorBrush x:Key="SettingsSectionBg" Color="#A3F7F8FA"/>
    <SolidColorBrush x:Key="SettingsContactCardBg" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="SettingsSectionBorder" Color="#12000000"/>
    <SolidColorBrush x:Key="SettingsCardBg" Color="#A3FFFFFF"/>
    <SolidColorBrush x:Key="SettingsCardBorder" Color="#22000000"/>
    <SolidColorBrush x:Key="SettingsGlassBorder" Color="#1F000000"/>
    <SolidColorBrush x:Key="SettingsWindowButtonHover" Color="#0F000000"/>
    <SolidColorBrush x:Key="SettingsWindowCloseHover" Color="#F2E8695C"/>
    <SolidColorBrush x:Key="SettingsNavButtonBg" Color="#00000000"/>
    <SolidColorBrush x:Key="SettingsNavText" Color="#FF111315"/>
    <SolidColorBrush x:Key="SettingsNavHover" Color="#09000000"/>
    <SolidColorBrush x:Key="SettingsNavPressed" Color="#12000000"/>
    <SolidColorBrush x:Key="SettingsNavLineBg" Color="#E8D9E4F6"/>
    <SolidColorBrush x:Key="SettingsNavCardsBg" Color="#E8E4DFF6"/>
    <SolidColorBrush x:Key="SettingsNavCaptureBg" Color="#E8D9EBEB"/>
    <SolidColorBrush x:Key="SettingsNavStartupBg" Color="#E8F3E8D5"/>
    <SolidColorBrush x:Key="SettingsNavLineIcon" Color="#1E6FFF"/>
    <SolidColorBrush x:Key="SettingsNavCardsIcon" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="SettingsNavCaptureIcon" Color="#2A9D8F"/>
    <SolidColorBrush x:Key="SettingsNavStartupIcon" Color="#D97706"/>
    <SolidColorBrush x:Key="FieldBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FieldBorder" Color="#22000000"/>
    <SolidColorBrush x:Key="AccentFill" Color="#1A63EA"/>
    <SolidColorBrush x:Key="TextDanger" Color="#B3261E"/>
    <SolidColorBrush x:Key="AccentFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentInk" Color="#1A63EA"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#181E6FFF"/>
    <SolidColorBrush x:Key="AccentHalo" Color="#521E6FFF"/>
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="UiBodyFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <sys:Double x:Key="UiBodyLineHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
    <sys:Double x:Key="UiControlFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">12.5</sys:Double>
    <sys:Double x:Key="UiControlLineHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">19</sys:Double>
    <sys:Double x:Key="UiSmallFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">11.5</sys:Double>
    <sys:Double x:Key="UiSmallLineHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">17</sys:Double>
    <sys:Double x:Key="UiCaptionFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">10.5</sys:Double>
    <sys:Double x:Key="UiCaptionLineHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="UiHeadingFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="UiHeadingLineHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">21</sys:Double>
    <sys:Double x:Key="UiWindowTitleFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="UiWindowTitleLineHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">26</sys:Double>
    <sys:Double x:Key="MenuRowHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">30</sys:Double>
    <Thickness x:Key="MenuRowMargin">0,1</Thickness>
    <!-- The same quiet surface language as the settings workspace, shared by
         the main menu and every card context menu. -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiBodyFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="14">
                        <Border CornerRadius="10" Background="{DynamicResource MenuBg}"
                                BorderBrush="{DynamicResource MenuBorder}" BorderThickness="1" Padding="5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.18" Color="Black"/>
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="{DynamicResource UiBodyFontSize}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="{StaticResource MenuRowHeight}"/>
        <Setter Property="Margin" Value="{StaticResource MenuRowMargin}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" CornerRadius="8" Margin="0" Padding="5,0"
                            Background="{TemplateBinding Background}" MinWidth="176"
                            Height="{StaticResource MenuRowHeight}">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="HoverWash" Grid.ColumnSpan="7" CornerRadius="7"
                                    Background="{DynamicResource MenuHover}" Opacity="0"
                                    IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                            <Border x:Name="FocusRing" Grid.ColumnSpan="7" CornerRadius="7"
                                    BorderBrush="{DynamicResource MenuFocus}" BorderThickness="1.2"
                                    Margin="1" Opacity="0" IsHitTestVisible="False"/>
                            <Viewbox Grid.Column="0" Width="13" Height="12" Stretch="Uniform"
                                     VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path x:Name="Check" Data="M20 6 L9 17 L4 12" Stroke="{DynamicResource AccentFill}" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="24" Height="24" Stretch="Uniform" Visibility="Hidden"/>
                            </Viewbox>
                            <Border x:Name="IconSurface" Grid.Column="1" Width="24" Height="24" CornerRadius="6"
                                    Background="{DynamicResource MenuIconBg}" VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <ContentPresenter x:Name="Icon" ContentSource="Icon" Width="18" Height="18"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="3" ContentSource="Header" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                            <TextBlock Grid.Column="4" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource MenuFgSecondary}"
                                       VerticalAlignment="Center" Margin="10,0,2,0"
                                       FontSize="{DynamicResource UiCaptionFontSize}"
                                       LineHeight="{DynamicResource UiCaptionLineHeight}"
                                       TextWrapping="NoWrap"/>
                            <Viewbox Grid.Column="6" Width="6" Height="10" Stretch="Uniform"
                                     VerticalAlignment="Center" Margin="5,0,0,0">
                                <Path x:Name="Arrow" Data="M9 18 L15 12 L9 6" Stroke="{DynamicResource MenuFgSecondary}" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="24" Height="24" Stretch="Uniform" Visibility="Collapsed"/>
                            </Viewbox>
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-6" VerticalOffset="-18"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Grid x:Name="PopupChrome" Margin="14" Background="Transparent">
                                    <Border x:Name="PopupSurface" CornerRadius="10" Background="{DynamicResource MenuBg}"
                                            BorderBrush="{DynamicResource MenuBorder}" BorderThickness="1" Padding="6">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.18" Color="Black"/>
                                        </Border.Effect>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="HoverWash" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverWash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="0:0:0.12"
                                                         FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverWash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0"
                                                         Duration="0:0:0.12"
                                                         FillBehavior="Stop"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuChecked}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconSurface" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="HoverWash" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="MenuSidePanelAnchor">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="-6"/>
                            <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="-14"/>
                            <Setter TargetName="PART_Popup" Property="PopupAnimation" Value="None"/>
                            <Setter TargetName="PopupChrome" Property="Margin" Value="0"/>
                            <Setter TargetName="PopupSurface" Property="Background" Value="Transparent"/>
                            <Setter TargetName="PopupSurface" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="PopupSurface" Property="Padding" Value="0"/>
                            <Setter TargetName="PopupSurface" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                        <Trigger Property="FlowDirection" Value="RightToLeft">
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Left"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Tag" Value="MenuSidePanelAnchor"/>
                                <Condition Property="FlowDirection" Value="RightToLeft"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Left"/>
                            <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="6"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.44"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuSidePanelHost" TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="StaysOpenOnClick" Value="True"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <ContentPresenter ContentSource="Header"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MenuSidePanelRow" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Height" Value="{StaticResource MenuRowHeight}"/>
        <Setter Property="Margin" Value="{StaticResource MenuRowMargin}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RowMotion" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform X="0"/>
                        </Grid.RenderTransform>
                        <Border x:Name="Row" CornerRadius="8" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="HoverWash" CornerRadius="7"
                                        Background="{DynamicResource MenuHover}" Opacity="0"
                                        IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                                <Border x:Name="PressWash" CornerRadius="7"
                                        Background="{DynamicResource MenuChecked}" Opacity="0"
                                        IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                                <Grid>
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      RecognizesAccessKey="True"/>
                                    <Border x:Name="FocusRing" CornerRadius="7" Margin="-1"
                                            BorderBrush="{DynamicResource MenuFocus}" BorderThickness="1.2"
                                            Opacity="0" IsHitTestVisible="False"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverWash" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverWash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="0:0:0.12"
                                                         FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="RowMotion"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="0" To="1"
                                                         Duration="0:0:0.12"
                                                         FillBehavior="HoldEnd">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverWash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0"
                                                         Duration="0:0:0.12"
                                                         FillBehavior="Stop"/>
                                        <DoubleAnimation Storyboard.TargetName="RowMotion"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="1" To="0"
                                                         Duration="0:0:0.12"
                                                         FillBehavior="Stop"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressWash" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressWash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="0:0:0.08"
                                                         FillBehavior="Stop"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressWash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0"
                                                         Duration="0:0:0.12"
                                                         FillBehavior="Stop"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Row" Property="Background" Value="Transparent"/>
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiCaptionFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid Margin="10">
                        <Border CornerRadius="6" Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource MenuBorder}" BorderThickness="1" Padding="10,6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.18" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{DynamicResource MenuSeparator}" Margin="6,2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Settings surface ===================== -->
    <!-- Quiet, rounded controls that follow the Menu* tokens, so the settings
         page reads the same in light and dark mode. -->

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource MenuFgSecondary}" Opacity="0.28" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.58"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="MinWidth" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Maximum" Value="0">
                <Setter Property="Opacity" Value="0"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButton}"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButton}"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SettingsSliderTrackButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"
                            VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsSliderThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="16" Height="16" Background="Transparent">
                        <Grid x:Name="ThumbMotion" RenderTransformOrigin="0.5,0.5">
