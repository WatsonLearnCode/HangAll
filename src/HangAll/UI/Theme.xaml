            <Grid Width="14" Height="24" Margin="0,0,8,0">
                <Border Width="9" Height="24" CornerRadius="2" Background="{Binding Body}"
                        BorderBrush="{Binding Stroke}" BorderThickness="0.5"/>
                <Border Width="13" Height="4" CornerRadius="1" Background="{Binding Band}"
                        VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

