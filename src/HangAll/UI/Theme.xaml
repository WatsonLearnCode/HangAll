                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="ThumbRing" Width="14" Height="14"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Fill="{DynamicResource FieldBg}"
                                     Stroke="{DynamicResource AccentFill}" StrokeThickness="2"
                                     SnapsToDevicePixels="True"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbRing" Property="StrokeThickness" Value="2.4"/>
