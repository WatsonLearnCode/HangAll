        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource UiControlFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource MenuFg}"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="5" Background="Transparent"
                                SnapsToDevicePixels="True"/>
                        <Border x:Name="HoverWash" CornerRadius="5" Background="{DynamicResource MenuHover}"
